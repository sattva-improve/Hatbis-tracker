# LocalStack用の環境変数
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_DEFAULT_REGION=ap-northeast-1

# DynamoDB
export DYNAMODB_ENDPOINT_URL=http://localhost:4566

# Cognito
export COGNITO_ENDPOINT_URL=http://localhost:4566
export COGNITO_USER_POOL_ID=ap-northeast-1_local
export COGNITO_CLIENT_ID=local-client

# Table names
export USERS_TABLE=habit-tracker-rpg-dev-users
export HABITS_TABLE=habit-tracker-rpg-dev-habits
export RECORDS_TABLE=habit-tracker-rpg-dev-records
export USER_ACHIEVEMENTS_TABLE=habit-tracker-rpg-dev-user-achievements
export USER_JOBS_TABLE=habit-tracker-rpg-dev-user-jobs

# Development flags
export AUTO_CONFIRM_USER=true
